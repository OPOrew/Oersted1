// Generates app/.../sim/PartsTable.kt from the web PARTS array (src/data/components.ts). Usage:
//   node_modules/.bin/tsx gen-parts.mts <web src dir> <out.kt>
// Only the fields derive() reads are emitted (id, name, system, ata, group, controls). Missing controls become null
// so the Kotlin side can reproduce the TS "undefined" text.
import { writeFileSync } from "fs";
const [SRC, OUT] = process.argv.slice(2);
const { PARTS } = await import(SRC + "/data/components.ts");
const q = (v: any) => JSON.stringify(String(v)).replace(/\$/g, "\\$");
const rows = (PARTS as any[]).map((p) =>
  `        PartRow(${q(p.id)}, ${q(p.name)}, ${q(p.system)}, ${q(p.ata)}, ${q(p.group)}, ${p.controls === undefined ? "null" : q(p.controls)})`
).join(",\n");
writeFileSync(OUT, `// GENERATED by tools/gen-parts.mts from src/data/components.ts (PARTS). Do not hand-edit.
package com.oersted.trainer.sim

data class PartRow(val id: String, val name: String, val system: String, val ata: String, val group: String, val controls: String?)

object PartsTable {
    val rows: List<PartRow> = listOf(
${rows}
    )
}
`);
console.log("parts", (PARTS as any[]).length);
