// Parity for autoflight.ts and markerBeacons.ts single calls. Writes AutoFlightWebParityTest.kt and MarkerWebParityTest.kt.
// Usage: node_modules/.bin/tsx fn/dump-af-marker.mts <web src dir> <out dir>
import { writeFileSync } from "fs";
const [SRC, OUT] = process.argv.slice(2);
const af = await import(SRC + "/lib/sim/autoflight.ts");
const mk = await import(SRC + "/lib/sim/markerBeacons.ts");
const { AF_CASES, MK_CASES } = await import(process.cwd() + "/fn/af-marker-cases.mts");
const lit = (v: number) => (Number.isInteger(v) ? v + ".0" : String(v));
const q = (s: string) => JSON.stringify(s);
const afTests: string[] = [];
for (const c of AF_CASES as any[]) {
  const r = c.call(af);
  let a: string;
  if (c.num) a = `        assertEquals(${lit(r)}, ${c.kt}, 1e-9)`;
  else if (c.bool) a = `        assertTrue(${c.kt} == ${r})`;
  else if (c.str) a = r === null ? `        assertTrue(${c.kt} == null)` : `        assertTrue(${c.kt} == ${q(r)})`;
  else if (c.lat) a = [`        val r = ${c.kt}`, `        assertEquals(${lit(r.bank)}, r.bank, 1e-9)`, `        assertEquals(${lit(r.lim)}, r.lim, 1e-9)`, `        assertEquals(${lit(r.rate)}, r.rate, 1e-9)`].join("\n");
  else if (c.glide) a = [`        val r = ${c.kt}`, `        assertTrue(r.phase.name == ${q(r.phase)})`, `        assertEquals(${lit(r.capT)}, r.capT, 1e-9)`].join("\n");
  else if (c.alt) a = [`        val r = ${c.kt}`, `        assertEquals(${lit(r.vsFpm)}, r.vsFpm, 1e-9)`, `        assertEquals(${lit(r.gamma)}, r.gamma, 1e-9)`, `        assertTrue(r.phase == ${q(r.phase)})`].join("\n");
  else if (c.light) a = `        assertTrue(${c.kt}.name == ${q(r)})`;
  else throw new Error("unknown case " + c.name);
  afTests.push(`    @Test fun ${c.name}() {\n${a}\n    }`);
}
writeFileSync(OUT + "/AutoFlightWebParityTest.kt", `// GENERATED by tools/parity/fn/dump-af-marker.mts from the web autoflight.ts. Do not hand-edit.
package com.oersted.trainer.sim

import org.junit.Assert.assertEquals
import org.junit.Assert.assertTrue
import org.junit.Test

class AutoFlightWebParityTest {
${afTests.join("\n\n")}
}
`);
const mkTests: string[] = [];
for (const c of MK_CASES as any[]) {
  const pos = { x: c.pos[0], y: c.pos[1] };
  const r = mk.markerCoverage(c.scene, pos, c.alt, c.high);
  mkTests.push(`    @Test fun ${c.name}() {
        val r = MarkerBeacons.markerCoverage(RadioNav.NavSceneId.${c.scene}, MarkerBeacons.Pos(${lit(c.pos[0])}, ${lit(c.pos[1])}), ${lit(c.alt)}, ${c.high})
        assertTrue(r.om == ${r.om})
        assertTrue(r.mm == ${r.mm})
        assertTrue(r.im == ${r.im})
    }`);
}
// marker keying: t values, the web answer for each marker id
for (const id of ["om", "mm", "im"]) {
  const ts = [0, 0.1, 0.2, 0.35, 0.4, 0.55, 0.7, 1.05, 1.5, 2.3];
  const rows = ts.map((t) => `        assertTrue(MarkerBeacons.markerKeyed(MarkerBeacons.MarkerId.${id.toUpperCase()}, ${lit(t)}) == ${mk.markerKeyed(id, t)})`);
  mkTests.push(`    @Test fun keyed_${id}() {\n${rows.join("\n")}\n    }`);
}
writeFileSync(OUT + "/MarkerWebParityTest.kt", `// GENERATED by tools/parity/fn/dump-af-marker.mts from the web markerBeacons.ts. Do not hand-edit.
package com.oersted.trainer.sim

import org.junit.Assert.assertTrue
import org.junit.Test

class MarkerWebParityTest {
${mkTests.join("\n\n")}
}
`);
console.log("af", (AF_CASES as any[]).length, "marker", (MK_CASES as any[]).length);
