// Parity for computeAirData() (pitotStatic.ts): for each section scenario's overrides (no ticks), record every primitive
// leaf of the air data except architecture / downstream / maintenance. Writes PitotAirWebParityTest.kt.
// Usage: TSX_TSCONFIG_PATH=<web>/tsconfig.json node_modules/.bin/tsx fn/dump-air.mts <web src dir> <section.mts> <out.kt>
import { writeFileSync } from "fs";
const [SRC, SECTION, OUT] = process.argv.slice(2);
const { initialSim } = await import(SRC + "/lib/sim/initial.ts");
const { useSim } = await import(SRC + "/lib/sim/store.ts");
const { computeAirData } = await import(SRC + "/lib/sim/pitotStatic.ts");
const { SCENARIOS } = await import(SECTION);
const SKIP = new Set(["architecture", "downstream", "maintenance"]);
function leaves(v: any, prefix: string, out: Record<string, any>) {
  if (v && typeof v === "object" && !Array.isArray(v)) { for (const [k, x] of Object.entries(v)) leaves(x, prefix + "." + k, out); }
  else if (Array.isArray(v)) return;
  else if (typeof v === "number" || typeof v === "string" || typeof v === "boolean") out[prefix] = v;
}
const lit = (v: any) => (typeof v === "boolean" ? String(v) : typeof v === "number" ? (Number.isInteger(v) ? v + ".0" : String(v)) : JSON.stringify(v));
// Kotlin cadc is a Map keyed by side: cadc.capt.x -> air.cadc["capt"]!!.x
const kpath = (f: string) => { const m = /^cadc\.(\w+)\.(.+)$/.exec(f); return m ? `cadc["${m[1]}"]!!.${m[2]}` : f; };
const dcOf = (x: any) => x;
const tests: string[] = [];
let count = 0;
for (const sc of SCENARIOS as any[]) {
  const merged: any = { ...initialSim };
  for (const [k, v] of Object.entries(sc.ov)) {
    merged[k] = v && typeof v === "object" && !Array.isArray(v) ? { ...(initialSim as any)[k], ...(v as any) } : v;
  }
  useSim.setState(merged as any, false);
  const cur: any = useSim.getState();
  const r: any = computeAirData(cur, true, true);
  const flat: Record<string, any> = {};
  for (const [k, v] of Object.entries(r)) {
    if (SKIP.has(k)) continue;
    leaves(v, k, flat);
  }
  const parts: string[] = [];
  for (const [k, v] of Object.entries(sc.ov)) {
    if (v && typeof v === "object" && !Array.isArray(v)) {
      for (const [sk, sv] of Object.entries(v as any)) {
        parts.push(k === "circuitBreakers" ? `${k}[${JSON.stringify(sk)}] = ${lit(sv)}` : `${k}.${sk} = ${lit(sv)}`);
      }
    } else parts.push(`${k} = ${lit(v)}`);
  }
  const asserts: string[] = [];
  for (const [f, e] of Object.entries(flat)) {
    count++;
    if (typeof e === "number") asserts.push(`        assertEquals("${f}", ${lit(e)}, (air.${kpath(f)}).toDouble(), 1e-6)`);
    else if (typeof e === "string") asserts.push(`        assertEquals("${f}", ${JSON.stringify(e)}, air.${kpath(f)})`);
    else asserts.push(`        assertEquals("${f}", ${e}, air.${kpath(f)})`);
  }
  tests.push(`    @Test fun ${sc.name.replace(/[^A-Za-z0-9_]/g, "_")}() {
        val st = initialSimState().apply { ${parts.join("; ")} }
        val air = PitotStatic.computeAirData(st, true, true)
${asserts.join("\n")}
    }`);
}
writeFileSync(OUT, `// GENERATED by tools/parity/fn/dump-air.mts from web computeAirData() (pitotStatic.ts). Do not hand-edit.
package com.oersted.trainer.sim

import org.junit.Assert.assertEquals
import org.junit.Assert.assertTrue
import org.junit.Test

class PitotAirWebParityTest {
${tests.join("\n\n")}
}
`);
console.log("scenarios", (SCENARIOS as any[]).length, "asserted leaves", count);
