// Parity for stepDmeChannel() (dmeModel.ts): runs the web function over each step sequence and writes DmeWebParityTest.kt.
// Usage: node_modules/.bin/tsx fn/dump-dme.mts <web src dir> <out.kt>
import { writeFileSync } from "fs";
const [SRC, OUT] = process.argv.slice(2);
const { stepDmeChannel, IDLE_DME } = await import(SRC + "/lib/sim/dmeModel.ts");
const { CASES } = await import(process.cwd() + "/fn/dme-cases.mts");
const lit = (v: number) => (Number.isInteger(v) ? v + ".0" : String(v));
const opt = (v: number | null) => (v === null ? "null" : lit(v));
const numAssert = (label: string, expected: number | null, actual: string) =>
  expected === null ? `        assertTrue(${actual} == null)` : `        assertEquals(${lit(expected)}, ${actual}!!, 1e-9)`;
const tests: string[] = [];
for (const c of CASES as any[]) {
  let prev = IDLE_DME;
  const lines: string[] = [];
  lines.push("        var s = DmeModel.IDLE_DME");
  c.steps.forEach((st: any, i: number) => {
    const r = stepDmeChannel({ prev, mode: st.mode, test: st.test, powered: st.powered, geomNm: st.geom, deltaAltFt: st.dAlt, dtSec: st.dt });
    lines.push(`        s = DmeModel.stepDmeChannel(s, ${st.mode}, ${st.test}, ${st.powered}, ${opt(st.geom)}, ${lit(st.dAlt)}, ${lit(st.dt)})`);
    lines.push(`        assertTrue(s.searching == ${r.searching})`);
    lines.push(`        assertTrue(s.locked == ${r.locked})`);
    lines.push(`        assertEquals(${lit(r.lockT)}, s.lockT, 1e-9)`);
    lines.push(`        assertEquals(${lit(r.memoryT)}, s.memoryT, 1e-9)`);
    lines.push(numAssert("displayNm", r.displayNm, "s.displayNm").replace("!!", r.displayNm === null ? "" : "!!"));
    lines.push(numAssert("lagNm", r.lagNm, "s.lagNm").replace("!!", r.lagNm === null ? "" : "!!"));
    prev = r;
  });
  tests.push(`    @Test fun ${c.name}() {\n${lines.join("\n")}\n    }`);
}
writeFileSync(OUT, `// GENERATED by tools/parity/fn/dump-dme.mts from the web stepDmeChannel() (dmeModel.ts). Do not hand-edit.
package com.oersted.trainer.sim

import org.junit.Assert.assertEquals
import org.junit.Assert.assertTrue
import org.junit.Test

class DmeWebParityTest {
${tests.join("\n\n")}
}
`);
console.log("cases", (CASES as any[]).length);
