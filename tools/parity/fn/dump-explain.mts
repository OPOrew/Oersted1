// Parity for explain() (situation.ts): tone, text of every line, for each input in explain-cases.mts.
// Usage: node_modules/.bin/tsx fn/dump-explain.mts <web src dir> <out.kt>
import { writeFileSync } from "fs";
const [SRC, OUT] = process.argv.slice(2);
const { explain } = await import(SRC + "/lib/sim/situation.ts");
const { EXPLAIN_CASES } = await import(process.cwd() + "/fn/explain-cases.mts");
const lit = (v: number) => (Number.isInteger(v) ? v + ".0" : String(v));
const q = (s: string) => JSON.stringify(s);
const sitK = (s: any) => `Situation.SituationSample(${lit(s.x)}, ${lit(s.y)}, ${lit(s.hdg)}, ${lit(s.altFt)}, ${lit(s.tasKt)}, ${s.flying}, LatSub.${s.latSub}, GsPhase.${s.gsPhase}, ${lit(s.gsCapT)})`;
const tests: string[] = [];
for (const c of EXPLAIN_CASES as any[]) {
  const i = c.inp;
  const r = explain(i);
  const n = i.nav;
  const navK = `RadioNav.RadioNavData(${n.vorValid}, ${n.locValid}, ${n.gsValid}, ${lit(n.radial)}, ${lit(n.locDev)}, ${lit(n.gsErr)}, ${lit(n.vorDist)}, ${lit(n.thrDist)})`;
  const inK = `Situation.ExplainIn(sit = ${sitK(i.sit)}, navOn = ${i.navOn}, tuned = ${q(i.tuned)}, nav = ${navK}, navValid = ${i.navValid}, selCrs = ${lit(i.selCrs)}, selHdg = ${lit(i.selHdg)}, apNav = ${i.apNav}, apHdgSw = ${i.apHdgSw}, apAil = ${i.apAil}, apElev = ${i.apElev}, apPitch = ${i.apPitch}, apWhy = ${q(i.apWhy)}, vorDev = ${lit(i.vorDev)})`;
  const lines: string[] = [`        val e = Situation.explain(${inK})`];
  const check = (list: string, arr: any[]) => {
    lines.push(`        assertEquals(${arr.length}, e.${list}.size)`);
    arr.forEach((l, k) => {
      lines.push(`        assertTrue(e.${list}[${k}].tone.label == ${q(l.tone)})`);
      lines.push(`        assertTrue(e.${list}[${k}].text == ${q(l.text)})`);
    });
  };
  check("lateral", r.lateral);
  check("vertical", r.vertical);
  tests.push(`    @Test fun ${c.name}() {\n${lines.join("\n")}\n    }`);
}
writeFileSync(OUT, `// GENERATED by tools/parity/fn/dump-explain.mts from the web explain() (situation.ts). Do not hand-edit.
package com.oersted.trainer.sim

import com.oersted.trainer.sim.AutoFlight.GsPhase
import com.oersted.trainer.sim.AutoFlight.LatSub
import org.junit.Assert.assertEquals
import org.junit.Assert.assertTrue
import org.junit.Test

class ExplainWebParityTest {
${tests.join("\n\n")}
}
`);
console.log("cases", (EXPLAIN_CASES as any[]).length);
