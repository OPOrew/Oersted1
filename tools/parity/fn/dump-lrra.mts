// Parity for resolveLrra() (lrra.ts): runs the web function for each case and writes LrraWebParityTest.kt.
// Usage: node_modules/.bin/tsx fn/dump-lrra.mts <web src dir> <out.kt>
import { writeFileSync } from "fs";
const [SRC, OUT] = process.argv.slice(2);
const { resolveLrra } = await import(SRC + "/lib/sim/lrra.ts");
const { CASES } = await import(process.cwd() + "/fn/lrra-cases.mts");
const lit = (v: number) => (Number.isInteger(v) ? v + ".0" : String(v));
const dbl = (v: number | null) => (v === null ? "null" : lit(v));
const chk = (name: string, ch: any) => [
  `        assertTrue(r.${name}.powered == ${ch.powered})`,
  `        assertTrue(r.${name}.valid == ${ch.valid})`,
  `        assertTrue(r.${name}.heightFt == ${dbl(ch.heightFt)})`,
  `        assertEquals(${lit(ch.dhFt)}, r.${name}.dhFt, 1e-9)`,
  `        assertTrue(r.${name}.dhLight == ${ch.dhLight})`,
  `        assertTrue(r.${name}.testing == ${ch.testing})`,
].join("\n");
const tests: string[] = [];
for (const c of CASES as any[]) {
  const r = resolveLrra({
    aglFt: c.agl, vsFpm: c.vs, dcPower: c.dc, cb1: c.cb1 ?? true, cb2: c.cb2 ?? true,
    fail1: c.f1 ?? false, fail2: c.f2 ?? false, dh1: c.dh1, dh2: c.dh2, test1: c.t1 ?? false, test2: c.t2 ?? false,
  });
  tests.push(`    @Test fun ${c.name}() {
        val r = Lrra.resolveLrra(${dbl(c.agl)}, ${lit(c.vs)}, ${c.dc}, ${c.cb1 ?? true}, ${c.cb2 ?? true}, ${c.f1 ?? false}, ${c.f2 ?? false}, ${lit(c.dh1)}, ${lit(c.dh2)}, ${c.t1 ?? false}, ${c.t2 ?? false})
${chk("ch1", r.ch1)}
${chk("ch2", r.ch2)}
    }`);
}
writeFileSync(OUT, `// GENERATED by tools/parity/fn/dump-lrra.mts from the web resolveLrra() (lrra.ts). Do not hand-edit.
package com.oersted.trainer.sim

import org.junit.Assert.assertEquals
import org.junit.Assert.assertTrue
import org.junit.Test

class LrraWebParityTest {
${tests.join("\n\n")}
}
`);
console.log("cases", (CASES as any[]).length);
