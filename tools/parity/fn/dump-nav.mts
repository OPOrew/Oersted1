// Parity for flightNavigation.ts advanceFlightNavigation() over telemetry sequences. The web module needs browser
// globals, so a minimal window / localStorage / CustomEvent shim is installed before import (plan is stored under its key).
// Usage: TSX_TSCONFIG_PATH=<web>/tsconfig.json node_modules/.bin/tsx fn/dump-nav.mts <web src dir> <out.kt>
import { writeFileSync } from "fs";
const [SRC, OUT] = process.argv.slice(2);
const store = new Map<string, string>();
(globalThis as any).window = {
  localStorage: { getItem: (k: string) => store.get(k) ?? null, setItem: (k: string, v: string) => { store.set(k, String(v)); }, removeItem: (k: string) => { store.delete(k); } },
  addEventListener() {}, removeEventListener() {}, dispatchEvent() { return true; },
};
(globalThis as any).CustomEvent = class { type: string; detail: any; constructor(t: string, o: any = {}) { this.type = t; this.detail = o.detail; } };
const nav = await import(SRC + "/lib/sim/flightNavigation.ts");
const { ACTIVE_FLIGHT_PLAN_KEY } = await import(SRC + "/lib/sim/activeFlightPlan.ts");
const lit = (v: number) => (Number.isInteger(v) ? v + ".0" : String(v));
const WP = { id: "MIA", name: "MIA", latitude: 14.5, longitude: 121.02, altitudeFt: 5000, speedKt: 250 };
const planOf = (activatedAt: string, timeCompression?: number) => ({
  version: 1, activatedAt, callsign: "TEST", departure: "RPLL", destination: "WSSS", alternate: "", departureRunway: "06", arrivalRunway: "02L",
  cruiseAltitudeFt: 35000, cruiseSpeedKt: 250, sid: "", enrouteRoute: "", star: "", approach: "", procedureStatus: "unverified",
  waypoints: [WP], ...(timeCompression !== undefined ? { timeCompression } : {}),
});
const T = (dt: number, gs: number, hdg: number, alt: number, wow: boolean) => ({ dt, groundSpeedKt: gs, headingDeg: hdg, altitudeFt: alt, wow });
const CASES = [
  { name: "taxi_then_takeoff", activatedAt: "2026-11-02T00:00:00Z", steps: [
    ...Array(3).fill(T(1, 0, 60, 0, true)), ...Array(4).fill(T(1, 15, 60, 0, true)), ...Array(6).fill(T(1, 180, 62, 3000, false)) ] },
  { name: "cruise_compressed", activatedAt: "2026-11-02T01:00:00Z", steps: Array(10).fill(T(1, 420, 60, 35000, false)) },
];
const tests: string[] = [];
for (const c of CASES) {
  store.clear();
  const plan = planOf(c.activatedAt);
  store.set(ACTIVE_FLIGHT_PLAN_KEY, JSON.stringify(plan));
  const lines: string[] = [];
  lines.push(`        val plan = ActiveFlightPlan(activatedAt = "${c.activatedAt}", callsign = "TEST", departure = "RPLL", destination = "WSSS", alternate = "", departureRunway = "06", arrivalRunway = "02L", cruiseAltitudeFt = 35000.0, cruiseSpeedKt = 250.0, sid = "", enrouteRoute = "", star = "", approach = "", procedureStatus = "unverified", waypoints = listOf(ActiveFlightWaypoint(id = "MIA", name = "MIA", latitude = 14.5, longitude = 121.02, altitudeFt = 5000.0, speedKt = 250.0)))`);
  lines.push(`        val nv = FlightNavigator()`);
  c.steps.forEach((t: any, i: number) => {
    // advance once per step, then compare the live state with the web state after the same call
    store.set(ACTIVE_FLIGHT_PLAN_KEY, JSON.stringify(plan));
    (nav as any).advanceFlightNavigation(t);
    const s: any = (nav as any).readFlightNavigationState();
    lines.push(`        nv.advance(plan, NavigationTelemetry(${lit(t.dt)}, ${lit(t.groundSpeedKt)}, ${lit(t.headingDeg)}, ${lit(t.altitudeFt)}, ${t.wow}))`);
    lines.push(`        run { val s = nv.liveState()!!`);
    lines.push(`        assertEquals(${lit(s.latitude)}, s.latitude, 1e-6)`);
    lines.push(`        assertEquals(${lit(s.longitude)}, s.longitude, 1e-6)`);
    lines.push(`        assertTrue(s.activeLegIndex == ${s.activeLegIndex})`);
    lines.push(`        assertTrue(s.phase.label == ${JSON.stringify(s.phase)})`);
    for (const f of ["distanceToDestinationNm", "distanceToNextNm", "trackTrueDeg", "timeCompression"] as const) {
      const v = s[f];
      lines.push(v === null || v === undefined ? `        assertTrue(s.${f} == null)` : `        assertEquals(${lit(v)}, s.${f}!!, 1e-6)`);
    }
    lines.push(`        }`);
  });
  tests.push(`    @Test fun ${c.name}() {\n${lines.join("\n")}\n    }`);
}
writeFileSync(OUT, `// GENERATED by tools/parity/fn/dump-nav.mts from the web advanceFlightNavigation() (flightNavigation.ts). Do not hand-edit.
package com.oersted.trainer.sim

import org.junit.Assert.assertEquals
import org.junit.Assert.assertTrue
import org.junit.Test

class NavigatorWebParityTest {
${tests.join("\n\n")}
}
`);
console.log("cases", CASES.length);
