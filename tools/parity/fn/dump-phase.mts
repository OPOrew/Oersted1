// Parity for flightPhases.ts loadPlanIntoControls() and canStart() against the web stores: records every top-level key
// the load changed in the sim, MIP and phase stores, plus the start gates after load. Writes PhaseWebParityTest.kt.
// Usage: TSX_TSCONFIG_PATH=<web>/tsconfig.json node_modules/.bin/tsx fn/dump-phase.mts <web src dir> <out.kt>
import { writeFileSync } from "fs";
const [SRC, OUT] = process.argv.slice(2);
const store = new Map<string, string>();
(globalThis as any).window = {
  localStorage: { getItem: (k: string) => store.get(k) ?? null, setItem: (k: string, v: string) => { store.set(k, String(v)); }, removeItem: (k: string) => { store.delete(k); } },
  addEventListener() {}, removeEventListener() {}, dispatchEvent() { return true; },
  setInterval: () => 0, clearInterval: () => {}, setTimeout: () => 0, clearTimeout: () => {},
};
(globalThis as any).CustomEvent = class { type: string; detail: any; constructor(t: string, o: any = {}) { this.type = t; this.detail = o.detail; } };
const { ACTIVE_FLIGHT_PLAN_KEY } = await import(SRC + "/lib/sim/activeFlightPlan.ts");
const pc = await import(SRC + "/lib/sim/flightPhases.ts");
const { useSim } = await import(SRC + "/lib/sim/store.ts");
const { useMip } = await import(SRC + "/lib/sim/mipLocal.ts");
const lit = (v: number) => (Number.isInteger(v) ? v + ".0" : String(v));
const plan = {
  version: 1, activatedAt: "2026-11-02T00:00:00Z", callsign: "TEST", departure: "RPLL", destination: "WSSS", alternate: "", departureRunway: "06", arrivalRunway: "02L",
  cruiseAltitudeFt: 35000, cruiseSpeedKt: 250, sid: "", enrouteRoute: "", star: "", approach: "", procedureStatus: "unverified", waypoints: [],
};
store.set(ACTIVE_FLIGHT_PLAN_KEY, JSON.stringify(plan));
const before = { sim: { ...useSim.getState() } as any, mip: { ...useMip.getState() } as any };
const ok = pc.loadPlanIntoControls();
const after = { sim: useSim.getState() as any, mip: useMip.getState() as any };
const changed = (a: any, b: any) => {
  const out: [string, any][] = [];
  for (const k of Object.keys(b)) {
    const v = b[k];
    if (typeof v === "function" || k === "log" || k.startsWith("__")) continue;
    if (typeof v === "number" || typeof v === "string" || typeof v === "boolean") { if (a[k] !== v) out.push([k, v]); }
  }
  return out;
};
const simChanged = changed(before.sim, after.sim);
const mipChanged = changed(before.mip, after.mip);
const phaseNow = pc.usePhase.getState().phase;
const gates = (["TAKEOFF", "CLIMB", "CRUISE", "DESCENT", "APPROACH", "LAND"] as const).map((p) => [p, pc.canStart(p)] as const);
const val = (v: any) => (typeof v === "boolean" ? String(v) : typeof v === "number" ? lit(v) : JSON.stringify(v));
const asrt = (who: string, k: string, v: any) => typeof v === "number" ? `        assertEquals("${k}", ${lit(v)}, (${who}["${k}"] as Number).toDouble(), 1e-9)` : typeof v === "boolean" ? `        assertEquals("${k}", ${v}, ${who}["${k}"])` : `        assertEquals("${k}", ${JSON.stringify(v)}, ${who}["${k}"])`;
const sim = simChanged.map(([k, v]) => asrt("w.sim", k, v));
const mip = mipChanged.map(([k, v]) => asrt("w.mip", k, v));
const gateLines = gates.map(([p, g]) => `        run { val g = c.canStart(Phase.${p}); assertTrue(g.ok == ${g.ok}); assertTrue(g.reason == ${JSON.stringify(g.reason)}) }`);
writeFileSync(OUT, `// GENERATED by tools/parity/fn/dump-phase.mts from the web loadPlanIntoControls() / canStart() (flightPhases.ts). Do not hand-edit.
package com.oersted.trainer.sim

import com.oersted.trainer.sim.FlightPhases.Phase
import org.junit.Assert.assertEquals
import org.junit.Assert.assertTrue
import org.junit.Test

class PhaseWebParityTest {
    private class FakeWorld(var plan: ActiveFlightPlan?) : PhaseWorld {
        var t = 0.0
        var sim: Map<String, Any?> = emptyMap()
        var mip: Map<String, Any?> = emptyMap()
        var ped: Map<String, Any?> = emptyMap()
        override fun nowMs(): Long = (t * 1000).toLong()
        override fun perfSec(): Double = t
        override fun activePlan(): ActiveFlightPlan? = plan
        override fun resetNavigation(plan: ActiveFlightPlan) {}
        override fun liveNavigation(): FlightNavigationState? = null
        override fun liveGuidance(): GuidanceResult = INACTIVE_GUIDANCE
        override fun simLive(): Map<String, Any?> = sim
        override fun simSnapshot(): Map<String, Any?> = sim.toMap()
        override fun patchSim(p: Map<String, Any?>) { sim = sim + p }
        override fun mipLive(): Map<String, Any?> = mip
        override fun mipSnapshot(): Map<String, Any?> = mip.toMap()
        override fun patchMip(p: Map<String, Any?>) { mip = mip + p }
        override fun pedestalLive(): Map<String, Any?> = ped
        override fun patchPedestal(p: Map<String, Any?>) { ped = ped + p }
    }

    private fun webPlan() = ActiveFlightPlan(
        activatedAt = "2026-11-02T00:00:00Z", callsign = "TEST", departure = "RPLL", destination = "WSSS",
        alternate = "", departureRunway = "06", arrivalRunway = "02L", cruiseAltitudeFt = 35000.0, cruiseSpeedKt = 250.0,
        sid = "", enrouteRoute = "", star = "", approach = "", procedureStatus = "unverified",
        waypoints = emptyList(), arrival = null, timeCompression = null,
    )

    @Test fun loadChangesMatchWeb() {
        val w = FakeWorld(webPlan())
        val c = PhaseController(w)
        assertTrue(c.loadPlanIntoControls())
        assertTrue(c.phase == Phase.READY)
${sim.join("\n")}
${mip.join("\n")}
    }

    @Test fun startGatesAfterLoadMatchWeb() {
        val w = FakeWorld(webPlan())
        val c = PhaseController(w)
        c.loadPlanIntoControls()
${gateLines.join("\n")}
    }
}
`);
console.log("loaded", ok, "phase", phaseNow, "sim keys", simChanged.length, "mip keys", mipChanged.length, "gates", gates.length);
