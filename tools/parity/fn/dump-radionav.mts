// Parity for radioNav() (radionav.ts): runs the web function for each case and writes a Kotlin test.
// Usage: node_modules/.bin/tsx fn/dump-radionav.mts <web src dir> <out.kt>
import { writeFileSync } from "fs";
const [SRC, OUT] = process.argv.slice(2);
const { radioNav } = await import(SRC + "/lib/sim/radionav.ts");
const { WSSS_ILS_02L } = await import(SRC + "/lib/sim/navData.ts");
const { CASES } = await import(process.cwd() + "/fn/radionav-cases.mts");
const lit = (v: number) => (Number.isInteger(v) ? v + ".0" : String(v));
const tests: string[] = [];
for (const c of CASES as any[]) {
  const freq = c.freq === "WSSS" ? WSSS_ILS_02L.frequencyMHz : c.freq;
  const r = radioNav({ x: c.p[0], y: c.p[1] }, c.alt, c.tuned, freq ?? undefined, c.scene);
  const kotlinFreq = freq === null ? "null" : lit(freq);
  const sceneK = c.scene === "WSSS02L" ? "RadioNav.NavSceneId.WSSS02L" : "RadioNav.NavSceneId.RPLL06";
  const asserts = [
    `        assertTrue(r.vorValid == ${r.vorValid})`,
    `        assertTrue(r.locValid == ${r.locValid})`,
    `        assertTrue(r.gsValid == ${r.gsValid})`,
    `        assertEquals(${lit(r.radial)}, r.radial, 1e-6)`,
    `        assertEquals(${lit(r.locDev)}, r.locDev, 1e-6)`,
    `        assertEquals(${lit(r.gsErr)}, r.gsErr, 1e-6)`,
    `        assertEquals(${lit(r.vorDist)}, r.vorDist, 1e-6)`,
    `        assertEquals(${lit(r.thrDist)}, r.thrDist, 1e-6)`,
  ].join("\n");
  tests.push(`    @Test fun ${c.name}() {
        val r = RadioNav.radioNav(RadioNav.Point(${lit(c.p[0])}, ${lit(c.p[1])}), ${lit(c.alt)}, RadioNav.NavStationKind.${c.tuned}, ${kotlinFreq}, ${sceneK})
${asserts}
    }`);
}
writeFileSync(OUT, `// GENERATED by tools/parity/fn/dump-radionav.mts from the web radioNav() (radionav.ts). Do not hand-edit.
package com.oersted.trainer.sim

import org.junit.Assert.assertEquals
import org.junit.Assert.assertTrue
import org.junit.Test

class RadioNavWebParityTest {
${tests.join("\n\n")}
}
`);
console.log("cases", (CASES as any[]).length);
