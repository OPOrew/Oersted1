// Parity for findNextSequenceItem() and pitot helpers (routeSequence.ts, pitotStatic.ts exports).
// Usage: TSX_TSCONFIG_PATH=<web>/tsconfig.json node_modules/.bin/tsx fn/dump-route.mts <web src dir> <out dir>
import { writeFileSync } from "fs";
const [SRC, OUT] = process.argv.slice(2);
const rs = await import(SRC + "/lib/sim/routeSequence.ts");
const pt = await import(SRC + "/lib/sim/pitotStatic.ts");
const lit = (v: number) => (Number.isInteger(v) ? v + ".0" : String(v));
const seq = rs.RPLL_WSSS_SEQUENCE;
const at = (i: number) => [seq[i]?.lat ?? 0, seq[i]?.lon ?? 0];
const cases: { name: string; lat: number; lon: number; idx: number }[] = [
  { name: "findnext_at_mia", lat: at(0)[0], lon: at(0)[1], idx: 0 },
  { name: "findnext_far_stays", lat: 0, lon: 0, idx: 0 },
  { name: "findnext_ils_early_from_vtk_leg", lat: at(2)[0], lon: at(2)[1], idx: 1 },
  { name: "findnext_end_of_sequence", lat: 0, lon: 0, idx: seq.length },
  { name: "findnext_at_vtk_advances_to_ils", lat: at(1)[0], lon: at(1)[1], idx: 1 },
];
const tests: string[] = [];
for (const c of cases) {
  const r = rs.findNextSequenceItem(c.lat, c.lon, c.idx);
  tests.push(`    @Test fun ${c.name}() {
        val r = RouteSequence.findNextSequenceItem(${lit(c.lat)}, ${lit(c.lon)}, ${c.idx})
        assertEquals(${r.index}, r.index)
        assertTrue(r.next?.id == ${r.next ? JSON.stringify(r.next.id) : "null"})
        assertEquals(${lit(r.distanceNm)}, r.distanceNm, 1e-6)
    }`);
}
writeFileSync(OUT + "/RouteSequenceWebParityTest.kt", `// GENERATED by tools/parity/fn/dump-route.mts from the web routeSequence.ts. Do not hand-edit.
package com.oersted.trainer.sim

import org.junit.Assert.assertEquals
import org.junit.Assert.assertTrue
import org.junit.Test

class RouteSequenceWebParityTest {
${tests.join("\n\n")}
}
`);
// Pitot helpers that are exported from the web module.
const pitot: string[] = [];
for (const hpa of [1013.25, 900, 700]) {
  pitot.push(`    @Test fun vmo_mmo_${Math.round(hpa)}() {\n        assertEquals(${lit(pt.vmoMmoLimitKt(hpa))}, PitotStatic.vmoMmoLimitKt(${lit(hpa)}), 1e-6)\n    }`);
}
pitot.push(`    @Test fun vmo_mmo_bad_pressure() {\n        assertEquals(${lit(pt.vmoMmoLimitKt(0))}, PitotStatic.vmoMmoLimitKt(0.0), 1e-9)\n    }`);
for (const [ice, heat, dc, ac, cb, grp, want] of [[true, false, true, true, true, false, true], [true, true, true, true, true, false, false], [true, false, true, false, true, false, true], [true, false, true, true, true, true, false], [false, false, true, true, true, false, false]] as const) {
  const got = pt.pitotIced(ice, heat, dc, ac, cb, grp);
  pitot.push(`    @Test fun iced_${ice}_${heat}_${ac}_${cb}_${grp}() {\n        assertTrue(PitotStatic.pitotIced(${ice}, ${heat}, ${dc}, ${ac}, ${cb}, ${grp}) == ${got})\n    }`);
}
writeFileSync(OUT + "/PitotWebParityTest.kt", `// GENERATED by tools/parity/fn/dump-route.mts from the web pitotStatic.ts exports. Do not hand-edit.
package com.oersted.trainer.sim

import org.junit.Assert.assertEquals
import org.junit.Assert.assertTrue
import org.junit.Test

class PitotWebParityTest {
${pitot.join("\n\n")}
}
`);
console.log("route", cases.length, "pitot", pitot.length);
