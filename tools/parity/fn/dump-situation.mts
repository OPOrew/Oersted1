// Parity for publishSituation() throttle and the trail rule (situation.ts). Usage: tsx fn/dump-situation.mts <web src> <out.kt>
import { writeFileSync } from "fs";
const [SRC, OUT] = process.argv.slice(2);
let T = 0;
Object.defineProperty(globalThis, "performance", { value: { now: () => T }, configurable: true });
const sit = await import(SRC + "/lib/sim/situation.ts");
const steps = [
  { t: 0, x: 1, y: 0 }, { t: 50, x: 1.5, y: 0 }, { t: 100, x: 1.6, y: 0 }, { t: 150, x: 1.6, y: 0.02 },
  { t: 200, x: 1.7, y: 0.5 }, { t: 260, x: 1.7, y: 0.5 }, { t: 300, x: 2.4, y: 0.6 }, { t: 399, x: 2.5, y: 0.6 }, { t: 400, x: 2.5, y: 0.6 },
];
const f = (n: number) => (Number.isInteger(n) ? n + ".0" : String(n));
const lines: string[] = [];
for (const s of steps) {
  T = s.t;
  const before: any = sit.useSituation.getState();
  sit.publishSituation({ x: s.x, y: s.y, hdg: 90, altFt: 0, tasKt: 0, flying: false, latSub: "OFF", gsPhase: "OFF", gsCapT: 0 } as any);
  const st: any = sit.useSituation.getState();
  const published = st !== before; // zustand replaces the state object on every publish
  lines.push(`        run { val ok = pub.publishThrottled(Situation.SituationSample(${f(s.x)}, ${f(s.y)}, 90.0, 0.0, 0.0, false, AutoFlight.LatSub.OFF, AutoFlight.GsPhase.OFF, 0.0), ${f(s.t)})
            assertTrue(ok == ${published}) ; assertEquals(${f(st.x)}, holder.state.sample.x, 1e-9) ; assertEquals(${st.trail.length}, holder.state.trail.size) }`);
  void before;
}
writeFileSync(OUT, `// GENERATED by tools/parity/fn/dump-situation.mts from the web publishSituation() (situation.ts). Do not hand-edit.
package com.oersted.trainer.sim

import org.junit.Assert.assertEquals
import org.junit.Assert.assertTrue
import org.junit.Test

class SituationWebParityTest {
    @Test fun publisherThrottleAndTrailMatchWeb() {
        val holder = Situation.SituationHolder()
        val pub = Situation.Publisher(holder)
${lines.join("\n")}
    }
}
`);
console.log("steps", steps.length);
