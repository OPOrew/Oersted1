// Generates a Kotlin trajectory test from dump-step.mts output: node gen-step-test.mts <step.json> <out.kt> <ClassName>
import { readFileSync, writeFileSync } from "fs";
const [JSON_IN, KT_OUT, CLS] = process.argv.slice(2);
const data = JSON.parse(readFileSync(JSON_IN, "utf8"));
const lit = (v: any) => (typeof v === "boolean" ? String(v) : typeof v === "number" ? (/[.eE]/.test(String(v)) ? String(v) : v + ".0") : JSON.stringify(v));
// Dotted names into a map (circuitBreakers.fuel-heat-1) become bracket access.
const access = (f: string) => {
  const m = /^circuitBreakers\.(.+)$/.exec(f);
  return m ? `circuitBreakers[${JSON.stringify(m[1])}]` : f;
};
const tests: string[] = [];
for (const sc of data.scenarios) {
  const parts: string[] = [];
  for (const [k, v] of Object.entries(sc.ov)) {
    if (v && typeof v === "object" && !Array.isArray(v)) {
      for (const [sk, sv] of Object.entries(v as any)) {
        parts.push(k === "circuitBreakers" ? `${k}[${JSON.stringify(sk)}] = ${lit(sv)}` : `${k}.${sk} = ${lit(sv)}`);
      }
    } else parts.push(`${k} = ${lit(v)}`);
  }
  const asserts: string[] = [];
  for (const f of data.fields) {
    const e = sc.expected[f];
    if (e === null || e === undefined) continue;
    // Nullable Kotlin fields (Double?) fall back to a value that never matches, so a null fails the test.
    const raw = `st.${access(f)}`;
    if (typeof e === "number") asserts.push(`        assertEquals("${f}", ${lit(e)}, (${raw} ?: Double.NaN), 1e-6)`);
    else if (typeof e === "string") asserts.push(`        assertEquals("${f}", ${lit(e)}, (${raw} ?: "<null>"))`);
    else asserts.push(`        assertEquals("${f}", ${e}, (${raw} ?: !${e}))`);
  }
  tests.push(`    @Test fun ${sc.name}() {
        val s = initialSimState().apply { ${parts.join("; ")} }
        var st = s
${sc.wxAfter
          ? `        for (i in 0 until ${sc.steps}) { st = StepSim.step(st, ${lit(sc.dt)}, if (i >= ${sc.wxAfter[0]}) ${lit(sc.wxAfter[1])} else ${lit(sc.wx)}) }`
          : `        repeat(${sc.steps}) { st = StepSim.step(st, ${lit(sc.dt)}, ${lit(sc.wx)}) }`}
${asserts.join("\n")}
    }`);
}
writeFileSync(KT_OUT, `// GENERATED by tools/parity/gen-step-test.mts from ${JSON_IN.split("/").pop()} (web step() trajectories). Do not hand-edit.
package com.oersted.trainer.sim

import org.junit.Assert.assertEquals
import org.junit.Test

class ${CLS} {
${tests.join("\n\n")}
}
`);
console.log("tests", data.scenarios.length);
